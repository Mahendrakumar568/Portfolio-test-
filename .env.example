# Password Jithendra uses to sign in at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
ADMIN_SECRET=replace-with-a-long-random-string
# Public URL of the site, used for SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosting (leave empty to keep content in /content on disk)
# Redis for settings and posts: Vercel's Redis integration sets these two.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob for images uploaded in the admin panel.
BLOB_READ_WRITE_TOKEN=
